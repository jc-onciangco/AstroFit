---
// src/pages/news/[...page].astro
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import { formatRelativeTime } from "../../scripts/utils/formatRelativeTime";
import Footer from "../../components/Footer.astro";
import NewsList from "../../components/NewsList.astro";

export async function getStaticPaths({ paginate }) {
  const news = await getCollection("news");

  const sortedNews = news.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );

  return paginate(sortedNews, { pageSize: 10 });
}

const { page } = Astro.props;
---

<Layout title="News | AstroFit">
  <Nav />
  <div class="w-full bg-[linear-gradient(to_right,transparent_0%,theme(colors.bg)_15%,theme(colors.bg)_85%,transparent_100%)]">
    <div class="mx-auto max-w-[720px] px-4 py-12 sm:px-6 sm:py-20">
      <div id="main-news">
        <NewsList news={page.data} displayExcerpt={true} />
      </div>
    
      <nav class="mt-10 flex items-center justify-center gap-4">
        {page.url.prev && <a href={page.url.prev}>← Previous</a>}
        <span class="font-mono text-xs text-text-secondary">
          Page {page.currentPage} of {page.lastPage}
        </span>
        {page.url.next && <a href={page.url.next}>Next →</a>}
      </nav>
    </div>

  </div>
  <Footer />
</Layout>

<script>
  import gsap from "gsap";

  gsap.from("#main-news a", {
    x: 100,
    opacity: 0,
    stagger: 0.15,
    duration: 0.6,
  });
</script>