---
import { getCollection } from 'astro:content';
import { formatRelativeTime } from '../scripts/utils/formatRelativeTime';

const news = await getCollection('news');
---

<section id="news" class="relative pt-14 pb-20 scroll-mt-[72px]">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_90%_70%_at_100%_100%,rgba(20,22,26,0)_0%,#14161A_85%)]"></div>

  <div class="relative z-10 mx-auto max-w-[1120px] px-6">
    <div class="mb-10 flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-5">
      <h2 class="sec1-header font-display text-[32px] uppercase tracking-wide">Latest news</h2>
      <a href="/news" class="font-mono text-xs tracking-wide text-text-secondary">
        See more
      </a>
    </div>

    <div class="list-news border-t border-line">
      {news.map((item) => (
        <a
          href={`/news/${item.id}`}
          class="flex flex-wrap items-baseline gap-x-5 gap-y-1.5 border-b border-line py-5 transition-[padding] hover:pl-2 sm:flex-nowrap"
        >
          <span class="w-[90px] flex-shrink-0 font-mono text-[11px] text-accent whitespace-nowrap">{formatRelativeTime(item.data.publishDate)}</span>
          <span class="order-3 w-full text-[15px] font-medium sm:order-none sm:w-auto sm:flex-grow">{item.data.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { fade } from "astro:transitions";
import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".sec1-header", {
    scrollTrigger: {
      trigger: "#news",
      start: "top 75%",
      end: "bottom 90%",
      toggleActions: "play none none reverse",
      scrub: false,
      markers: false, // uncomment to debug
    },
    y: 100,
    opacity: 0,
  });

  gsap.from(".list-news a", {
    scrollTrigger: {
      trigger: ".list-news",
      start: "top 75%",
      markers: false,
      toggleActions: "play none none reverse",
    },
    x: 100,
    opacity: 0,
    stagger: 0.15,
    duration: 0.6,
  });
</script>
