---
const { class: className } = Astro.props;
---

<svg class={className} width="150" height="150" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Bar -->
    <line x1="14" y1="24" x2="34" y2="24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Left weight plates -->
    <rect x="4" y="14" width="6" height="20" rx="2" stroke="currentColor" stroke-width="2.5"/>
    <rect x="10" y="18" width="4" height="12" rx="1.5" stroke="currentColor" stroke-width="2.5"/>
    <!-- Right weight plates -->
    <rect x="38" y="14" width="6" height="20" rx="2" stroke="currentColor" stroke-width="2.5"/>
    <rect x="34" y="18" width="4" height="12" rx="1.5" stroke="currentColor" stroke-width="2.5"/>
</svg>

  <style>

    svg {
      rotate: 45deg;
    }

  </style>