---
const { class: className } = Astro.props;
---
<svg class={className} width="150" height="150" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Crescent moon -->
    <path
      d="M31 6C25.5 8.3 22 13.7 22 20C22 28.3 28.7 35 37 35C38.6 35 40.1 34.7 41.5 34.2C38.6 39.9 32.7 44 26 44C16.6 44 9 36.4 9 27C9 17.6 16.6 10 26 10C27.7 10 29.4 10.3 31 10.7"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Little sparkle stars -->
    <path
      d="M38 8V12M36 10H40"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
    <path
      d="M33 16V18.5M31.75 17.25H34.25"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>

  <style>

    svg {
      rotate: -45deg;
      translate: 10% 0;
    }

  </style>