---
---

<section class="border-y border-line bg-bg-alt py-[70px] text-center">
  <div class="mx-auto max-w-[1120px] px-6">
    <p class="mb-4 font-mono text-xs tracking-[2px] text-accent uppercase">Join the log</p>
    <h2 class="mb-3.5 font-display text-[28px] uppercase tracking-wide sm:text-[44px]">
      Get next week's plan first
    </h2>
    <p class="mx-auto mb-[30px] max-w-[420px] text-[15px] text-text-secondary">
      One email a week. New workouts, real numbers, no fluff.
    </p>

    <form class="mx-auto flex max-w-[420px] flex-wrap justify-center gap-2.5">
      <input
        type="email"
        placeholder="name@email.com"
        required
        class="min-w-[220px] flex-1 border border-line bg-bg px-4 py-3.5 text-sm text-[#F4F4EF] placeholder:text-text-secondary focus:border-accent focus:outline-none"
      />
      <button
        type="submit"
        class="bg-accent px-7 py-[15px] font-mono text-[13px] font-semibold tracking-wide text-bg transition-colors hover:bg-accent-dim"
      >
        Sign up
      </button>
    </form>

    <p class="mt-3.5 font-mono text-[11px] text-text-secondary">No spam. Unsubscribe anytime.</p>
  </div>
</section>
